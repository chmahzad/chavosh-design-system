          "$type": "dimension",
          "$value": "{size.1000}",
          "$description": "RESTRICTED. For dense, pointer-first Desktop and Tablet contexts only (tables, filter bars, toolbars). Not the default and not the accessible minimum; never on Mobile or native. The hit area must still reach size/touch-target/min.",
          "$extensions": {
