{
  "border-width": {
    "default": {
      "$type": "dimension",
      "$value": "{border-width.1}",
      "$description": "Standard width for any visible edge: inputs, cards, dividers, outlined buttons and overlay edges.",
      "$extensions": {
        "chavosh": {
          "layer": "dimension",
          "visibility": "public",
          "css": "--ch-border-width-default",
          "figma": {
            "variableId": "VariableID:5:86",
            "collection": "Dimension",
            "collectionId": "VariableCollectionId:5:58",
            "path": "border-width/default",
            "resolvedType": "FLOAT",
            "scopes": [
              "STROKE_FLOAT"
            ],
            "codeSyntax": {
              "WEB": "var(--border-width-default)"
            }
          }
        }
      }
    }
  },
  "focus": {
    "width": {
      "indicator": {
        "$type": "dimension",
        "$value": "{border-width.3}",
        "$description": "Width of the main focus ring drawn directly around the focused element; pairs with color/focus/indicator. Always used with focus/width/outer; never for borders. In forced-colours mode, both rings become one system outline.",
        "$extensions": {
          "chavosh": {
            "layer": "dimension",
            "visibility": "public",
            "css": "--ch-focus-width-indicator",
            "figma": {
              "variableId": "VariableID:5:89",
              "collection": "Dimension",
              "collectionId": "VariableCollectionId:5:58",
              "path": "focus/width/indicator",
              "resolvedType": "FLOAT",
              "scopes": [
                "STROKE_FLOAT"
              ],
              "codeSyntax": {
                "WEB": "var(--focus-width-indicator)"
              }
            }
          }
        }
      },
      "outer": {
        "$type": "dimension",
        "$value": "{border-width.2}",
        "$description": "Width of the contrast ring drawn outside the main focus ring; pairs with color/focus/outer so focus stays visible on any background. Always used with focus/width/indicator.",
        "$extensions": {
          "chavosh": {
            "layer": "dimension",
            "visibility": "public",
            "css": "--ch-focus-width-outer",
            "figma": {
              "variableId": "VariableID:5:90",
              "collection": "Dimension",
              "collectionId": "VariableCollectionId:5:58",
              "path": "focus/width/outer",
              "resolvedType": "FLOAT",
              "scopes": [
                "STROKE_FLOAT"
              ],
              "codeSyntax": {
                "WEB": "var(--focus-width-outer)"
              }
            }
          }
        }
      }
    }
  },
  "font": {
    "family": {
      "sans": {
